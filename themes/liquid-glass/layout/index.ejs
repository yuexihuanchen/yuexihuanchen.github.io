<div class="page">

    <!-- =========================================
         Navigation
         ========================================= -->

    <header class="glass-header">

        <h1>
            <a href="/">YUEXIHUANCHEN</a>
        </h1>

        <nav>
            <a href="/">Home</a>
            <a href="/archives/">Blog</a>
            <a href="/projects/">Projects</a>
            <a href="/about/">About</a>
        </nav>

    </header>


    <main>

        <!-- =========================================
             Hero
             ========================================= -->

        <section class="hero">

            <p class="eyebrow">
                PERSONAL TECH BLOG
            </p>

            <h2>
                YUEXIHUANCHEN
            </h2>

            <div class="hero-line"></div>

            <p class="hero-role">
                Backend Developer
            </p>


            <!-- Technology Stack -->

            <div class="tech-stack">

                <span class="tech-tag">
                    Java
                </span>

                <span class="tech-tag">
                    Spring Boot
                </span>

                <span class="tech-tag">
                    MySQL
                </span>

                <span class="tech-tag">
                    Docker
                </span>

                <span class="tech-tag">
                    AI
                </span>

            </div>

        </section>


        <!-- =========================================
             Latest Posts
             ========================================= -->

        <section class="posts">

            <div class="section-title">

                <h2>
                    Latest Posts
                </h2>

                <span></span>

            </div>


            <div class="post-list">

                <% page.posts.each(function(post){ %>

                    <article class="post-card">

                        <!-- Post Image -->

                        <div class="post-image">

                            <div class="post-image-placeholder">
                                ✦
                            </div>

                        </div>


                        <!-- Post Information -->

                        <div class="post-info">

                            <h3>

                                <a href="<%- url_for(post.path) %>">
                                    <%= post.title %>
                                </a>

                            </h3>


                            <p class="post-excerpt">

                                <%= post.excerpt || '记录技术学习、项目实践与成长过程。' %>

                            </p>


                            <div class="post-meta">

                                <time>
                                    <%= date(post.date, 'YYYY-MM-DD') %>
                                </time>


                                <% if (post.tags && post.tags.length) { %>

                                    <% post.tags.slice(0, 2).forEach(function(tag){ %>

                                        <span class="post-tag">
                                            <%= tag.name %>
                                        </span>

                                    <% }); %>

                                <% } %>

                            </div>

                        </div>


                        <!-- Arrow -->

                        <a
                            class="post-arrow"
                            href="<%- url_for(post.path) %>"
                            aria-label="Read article"
                        >
                            →
                        </a>

                    </article>

                <% }); %>

            </div>

        </section>

    </main>

</div>

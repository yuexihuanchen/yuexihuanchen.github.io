<div class="page">

    <header class="glass-header">
        <h1>
            <a href="/">YUEXIHUANCHEN</a>
        </h1>

        <nav>
            <a href="/">Home</a>
            <a href="/archives/">Blog</a>
        </nav>
    </header>

    <main>

        <article class="post-detail">

            <header class="post-header">

                <p class="eyebrow">
                    <%= date(page.date, 'YYYY-MM-DD') %>
                </p>

                <h1>
                    <%= page.title %>
                </h1>

            </header>

            <div class="post-content">
                <%- page.content %>
            </div>

        </article>

    </main>

</div>
